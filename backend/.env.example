APP_NAME=CodePilot AI
APP_VERSION=0.1.0
DEBUG=True

HOST=127.0.0.1
PORT=8000

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://code-pilot-ai-puce.vercel.app"]

# Groq powers the RAG/chat completion. Required in production.
GROQ_API_KEY=

# Optional: used to clone private GitHub repositories. Public repos do not
# need it (only required if your repos are private).
GITHUB_TOKEN=

# Postgres connection string (e.g. Neon, Render Postgres).
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Qdrant vector database URL.
# - Local dev / DEBUG=True: leave empty ("") to use an in-memory store.
# - Production / DEBUG=False: a running remote cluster is REQUIRED,
#   e.g. https://your-cluster.cloud.qdrant.io. In-memory is rejected in
#   production because the vector index must survive restarts.
QDRANT_URL=

# Secret for authenticating with a hosted Qdrant cluster.
QDRANT_API_KEY=

# Embedding model used by fastembed (OnnxRuntime). Smaller models keep
# memory low while still capturing code semantics.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM model used for grounded RAG answers and the coding agent.
GROQ_MODEL=llama-3.3-70b-versatile

# Retrieval knobs.
TOP_K=5                  # number of context snippets retrieved per query
RAG_CONTEXT_MAX_CHARS=8000

# Agent runtime.
AGENT_MAX_STEPS=5

# Indexing knobs. Tune these down on low-memory instances.
INDEX_BATCH_SIZE=2       # file chunks per embedding batch
MAX_INDEX_FILE_SIZE_MB=0.5  # per-file cap (0.5 MB ≈ 512 KB)
MAX_FILE_SIZE_BYTES=0    # explicit byte override; 0 = use MAX_INDEX_FILE_SIZE_MB
MAX_INDEX_FILES=1000     # maximum files indexed per repository